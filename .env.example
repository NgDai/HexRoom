# ==============================================================================
# HexRoom - Cấu hình triển khai Docker Compose (.env)
# Sao chép file này thành .env để tùy chỉnh môi trường: cp .env.example .env
# ==============================================================================

# Cổng truy cập bên ngoài
FRONTEND_PORT=80
BACKEND_PORT=8080
POSTGRES_PORT=5432

# Cấu hình Cơ sở dữ liệu PostgreSQL cục bộ
POSTGRES_DB=hexroom_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hexroom_secure_db_password_2026!

# Nếu bạn muốn kết nối tới cơ sở dữ liệu trên mây (Supabase, Neon, AWS RDS...):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.your_project_id
# SPRING_DATASOURCE_PASSWORD=your_secure_password

# Cấu hình JWT Token (Bắt buộc tối thiểu 32 ký tự cho HS256)
JWT_SECRET=hexroom_very_secret_jwt_key_that_is_at_least_32_characters_long_1234567890!
JWT_EXPIRES_IN_MS=900000
REFRESH_TOKEN_EXPIRES_IN_MS=604800000
REFRESH_TOKEN_COOKIE_NAME=hexroom_refresh_token
APP_JWT_COOKIE_SECURE=false

# Cấu hình CORS cho Backend (phân tách bởi dấu phẩy)
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Cấu hình Dịch vụ Lưu trữ Đám mây Cloudinary (Tùy chọn)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cấu hình Frontend API URL
# Để trống nếu muốn Nginx tự động reverse proxy (/api -> backend:8080)
# Hoặc điền URL đầy đủ nếu triển khai Frontend và Backend trên 2 tên miền/server khác nhau
VITE_API_URL=
