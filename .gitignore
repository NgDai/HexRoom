# Root .gitignore for HexRoom Monorepo

# IDE & Editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.sw?
*.DS_Store

# Logs
*.log
logs/

# Backend (Java / Spring Boot / Maven)
HexRoom-backend/target/
HexRoom-backend/.idea/
HexRoom-backend/.data/
HexRoom-backend/.env
HexRoom-backend/*.log
!.mvn/wrapper/maven-wrapper.jar

# Frontend (Node / Vite / React)
HexRoom-frontend/node_modules/
HexRoom-frontend/dist/
HexRoom-frontend/dist-ssr/
HexRoom-frontend/*.local
HexRoom-frontend/.env
HexRoom-frontend/.env.local
HexRoom-frontend/.env.*.local
HexRoom-frontend/.env.deploy
HexRoom-frontend/.idea/
HexRoom-frontend/.vscode/*
!HexRoom-frontend/.vscode/extensions.json
