# ===================================================================
# HexRoom Backend - Mẫu cấu hình môi trường (.env.example)
# Sao chép file này thành .env hoặc thiết lập các biến môi trường tương ứng
# ===================================================================

# Cổng máy chủ Spring Boot
PORT=8080

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hexroom_db?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Cấu hình Spring Security & JWT Token
# Secret key phải có độ dài tối thiểu 256 bits (32 ký tự) cho thuật toán HS256
JWT_SECRET=your_32_characters_long_jwt_secret_key_hexroom_2026!
JWT_EXPIRES_IN_MS=900000
REFRESH_TOKEN_EXPIRES_IN_MS=604800000
REFRESH_TOKEN_COOKIE_NAME=hexroom_refresh_token
APP_JWT_COOKIE_SECURE=false

# Cấu hình CORS (Cho phép giao diện Frontend truy cập)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Cấu hình Dịch vụ Lưu trữ Đám mây Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Hoặc dùng định dạng URL đầy đủ:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Cấu hình Lưu trữ Cục bộ khi Fallback (Media directory)
MEDIA_DIRECTORY=.data/uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:8080
